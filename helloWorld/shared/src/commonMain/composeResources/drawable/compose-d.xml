<vector
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:aapt="http://schemas.android.com/aapt"
        android:width="450dp"
        android:height="450dp"
        android:viewportWidth="64"
        android:viewportHeight="64">

    <!--
        D SHAPE
        Overall silhouette:
        Left vertical stem + rounded right side
    -->
    <path
            android:pathData="
            M14,8
            L34,8
            C48,8 56,17 56,32
            C56,47 48,56 34,56
            L14,56
            Z

            M25,19
            L34,19
            C41,19 45,24 45,32
            C45,40 41,45 34,45
            L25,45
            Z"
            android:fillType="evenOdd">

        <aapt:attr name="android:fillColor">
            <gradient
                    android:startX="14"
                    android:startY="10"
                    android:endX="55"
                    android:endY="54"
                    android:type="linear">

                <item
                        android:offset="0"
                        android:color="#D46A6A"/>

                <item
                        android:offset="0.35"
                        android:color="#550000"/>

                <item
                        android:offset="0.65"
                        android:color="#6AD4AC"/>

                <item
                        android:offset="1"
                        android:color="#005434"/>
            </gradient>
        </aapt:attr>
    </path>


    <!--
        LEFT / FRONT FACET
        Creates the darker maroon extrusion.
    -->
    <path
            android:pathData="
            M14,8
            L25,19
            L25,45
            L14,56
            Z">

        <aapt:attr name="android:fillColor">
            <gradient
                    android:startX="14"
                    android:startY="8"
                    android:endX="25"
                    android:endY="56"
                    android:type="linear">

                <item
                        android:offset="0"
                        android:color="#D46A6A"/>

                <item
                        android:offset="0.35"
                        android:color="#550000"/>

                <item
                        android:offset="1"
                        android:color="#550000"/>
            </gradient>
        </aapt:attr>
    </path>


    <!--
        TOP FACET
        Gives the D its folded geometric appearance.
    -->
    <path
            android:pathData="
            M14,8
            L34,8
            C43,8 51,13 54,21
            L44,27
            C42,22 39,19 34,19
            L25,19
            Z">

        <aapt:attr name="android:fillColor">
            <gradient
                    android:startX="18"
                    android:startY="8"
                    android:endX="51"
                    android:endY="25"
                    android:type="linear">

                <item
                        android:offset="0"
                        android:color="#D46A6A"/>

                <item
                        android:offset="0.55"
                        android:color="#D46A6A"/>

                <item
                        android:offset="1"
                        android:color="#550000"/>
            </gradient>
        </aapt:attr>
    </path>


    <!--
        RIGHT / MINT FACET
    -->
    <path
            android:pathData="
            M54,21
            C55.3,24.5 56,28 56,32
            C56,36 55.3,39.5 54,43
            L44,37
            C44.7,35.4 45,33.7 45,32
            C45,30.2 44.7,28.5 44,27
            Z">

        <aapt:attr name="android:fillColor">
            <gradient
                    android:startX="54"
                    android:startY="20"
                    android:endX="45"
                    android:endY="43"
                    android:type="linear">

                <item
                        android:offset="0"
                        android:color="#6AD4AC"/>

                <item
                        android:offset="1"
                        android:color="#005434"/>
            </gradient>
        </aapt:attr>
    </path>


    <!--
        BOTTOM FACET
    -->
    <path
            android:pathData="
            M14,56
            L34,56
            C43,56 51,51
            L54,43
            L44,37
            C42,42 39,45 34,45
            L25,45
            Z">

        <aapt:attr name="android:fillColor">
            <gradient
                    android:startX="18"
                    android:startY="54"
                    android:endX="53"
                    android:endY="39"
                    android:type="linear">

                <item
                        android:offset="0"
                        android:color="#005434"/>

                <item
                        android:offset="0.6"
                        android:color="#005434"/>

                <item
                        android:offset="1"
                        android:color="#6AD4AC"/>
            </gradient>
        </aapt:attr>
    </path>


    <!--
        INNER D CUTOUT
        Keeps the center transparent/dark.
    -->
    <path
            android:pathData="
            M25,19
            L34,19
            C41,19 45,24 45,32
            C45,40 41,45 34,45
            L25,45
            Z"
            android:fillColor="#000000"/>

</vector>